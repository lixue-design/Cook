:host { display: block; }

button { margin: 0; padding: 0; border: 0; border-radius: 0; background: #ffffff; font-family: "PingFang SC", sans-serif; }
button::after { border: 0; }

.action-sheet-root { position: fixed; z-index: 300; top: 0; right: 0; left: 0; }

.action-sheet-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.6);
  animation: action-sheet-mask-in 220ms ease-out both;
}

.action-sheet-mask--closing { animation: action-sheet-mask-out 260ms ease-in both; }

.action-sheet-panel {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  overflow: hidden;
  background: #ffffff;
  transform: translateY(100%);
}

.action-sheet-panel--opening { animation: action-sheet-panel-in 300ms cubic-bezier(0.22, 1, 0.36, 1) both; }
.action-sheet-panel--closing { animation: action-sheet-panel-out 260ms cubic-bezier(0.4, 0, 1, 1) both; }

.action-sheet-title {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 104rpx;
  padding: 0 32rpx;
  overflow: hidden;
  box-sizing: border-box;
  border-bottom: 1rpx solid #ebedf2;
  color: #7b818f;
  font-family: "PingFang SC", sans-serif;
  font-size: 24rpx;
  font-weight: 400;
  letter-spacing: -0.72rpx;
  line-height: 40rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.action-sheet-option,
.action-sheet-cancel {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 104rpx;
  box-sizing: border-box;
  color: #000000;
  background: #ffffff;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 48rpx;
  text-align: center;
}

.action-sheet-option { border-bottom: 1rpx solid #ebedf2; }
.action-sheet-option--destructive { color: #fa4e32; }
.action-sheet-gap { height: 16rpx; background: #f6f8fb; }
.action-sheet-safe-area { min-height: 0; background: #ffffff; }

@keyframes action-sheet-panel-in { from { transform: translateY(100%); } to { transform: translateY(0); } }
@keyframes action-sheet-panel-out { from { transform: translateY(0); } to { transform: translateY(100%); } }
@keyframes action-sheet-mask-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes action-sheet-mask-out { from { opacity: 1; } to { opacity: 0; } }

@media (prefers-reduced-motion: reduce) {
  .action-sheet-mask, .action-sheet-panel { animation: none; }
  .action-sheet-panel { transform: translateY(0); }
}
