:host {
  display: block;
  width: 100%;
  height: 92rpx;
}

.date-range-switcher {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 92rpx;
  background: #ffffff;
}

.date-range-switcher::after {
  position: absolute;
  right: var(--date-range-divider-inset, 48rpx);
  bottom: 0;
  left: var(--date-range-divider-inset, 48rpx);
  height: var(--size-auxiliary-line, 0.5px);
  background: var(--color-auxiliary-line, #ebedf2);
  content: '';
}

.date-range-switcher--without-divider::after { display: none; }

.date-range-title {
  max-width: 560rpx;
  padding: 12rpx 16rpx;
  box-sizing: border-box;
  color: #000000;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 52rpx;
  white-space: nowrap;
}

.date-range-nav {
  position: absolute;
  top: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
}

.date-range-nav::after { border: 0; }
.date-range-nav--previous { left: 16rpx; }
.date-range-nav--next { right: 16rpx; }
.date-range-nav image { display: block; width: 40rpx; height: 40rpx; }
