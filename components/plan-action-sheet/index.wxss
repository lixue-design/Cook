:host { display: block; }
button { margin: 0; padding: 0; border: 0; background: transparent; font-family: "PingFang SC"; }
button::after { border: 0; }
.plan-action-sheet { position: relative; width: 100%; height: 100%; overflow: hidden; color: #000; background: #fff; font-family: "PingFang SC"; }
.plan-action-option { position: absolute; right: 0; left: 0; display: flex; align-items: center; flex-direction: column; width: 100%; }
.plan-action-option--ai { top: 0; height: 164rpx; }
.plan-action-option--manual { top: 166rpx; height: 142rpx; }
.plan-action-title { height: 48rpx; color: #000; font-size: 28rpx; font-weight: 400; line-height: 48rpx; }
.plan-action-description { height: 40rpx; color: #999; font-size: 24rpx; font-weight: 400; line-height: 40rpx; text-align: center; }
.plan-action-option--ai .plan-action-title { margin-top: 48rpx; }
.plan-action-option--manual .plan-action-title { margin-top: 28rpx; }
.plan-action-line { position: absolute; top: 164rpx; right: 0; left: 0; height: var(--size-auxiliary-line, .5px); background: #e2ebea; box-shadow: inset 0 -1rpx 0 #fff; }
.plan-action-band { position: absolute; top: 310rpx; right: 0; left: 0; height: 16rpx; background: #edf2f2; box-shadow: inset 0 -1rpx 0 #fff; }
.plan-action-cancel { position: absolute; top: 326rpx; right: 0; left: 0; width: 100%; height: 116rpx; color: #000; background: #fff; font-size: 28rpx; font-weight: 400; line-height: 116rpx; text-align: center; }
.plan-action-safe-area { position: absolute; right: 0; bottom: 0; left: 0; height: 56rpx; background: #fff; }
