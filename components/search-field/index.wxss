:host { display: block; width: 100%; height: 72rpx; }
.search-field { display: flex; align-items: center; width: 100%; height: 72rpx; padding: 0 24rpx; box-sizing: border-box; border-radius: 8rpx; background: #f5f6f7; }
.search-field-icon { width: 40rpx; height: 40rpx; flex: none; }
.search-field-input { min-width: 0; height: 40rpx; flex: 1; margin-left: 16rpx; padding: 0; color: #000000; font-family: "PingFang SC"; font-size: 28rpx; font-weight: 400; line-height: 40rpx; }
.search-field-placeholder { color: #b0b6c3; }
.search-field-clear { display: flex; align-items: center; justify-content: center; width: 32rpx; height: 32rpx; flex: none; margin: 0; padding: 0; background: transparent; }
.search-field-clear::after { border: 0; }
.search-field-clear image { width: 32rpx; height: 32rpx; }
