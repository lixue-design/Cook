button { margin: 0; padding: 0; border: 0; background: transparent; font-family: "PingFang SC"; }
button::after { border: 0; }
.wheel-picker { position: relative; width: 100%; height: 100%; overflow: hidden; background: #ffffff; font-family: "PingFang SC"; }
.wheel-picker-header { position: absolute; top: 0; right: 0; left: 0; height: 100rpx; border-bottom: 1rpx solid #e2ebea; }
.wheel-picker-action { position: absolute; top: 24rpx; height: 52rpx; color: #000000; font-size: 32rpx; font-weight: 400; line-height: 52rpx; }
.wheel-picker-action--cancel { left: 32rpx; color: #999999; }
.wheel-picker-action--confirm { right: 32rpx; }
.wheel-picker-wheel { position: absolute; top: 100rpx; right: 0; left: 0; height: 380rpx; overflow: hidden; }
.wheel-picker-selection-slot { position: absolute; z-index: 0; top: 152rpx; right: 0; left: 0; height: 76rpx; background: #f5f5f5; }
.wheel-picker-options { position: relative; z-index: 1; width: 100%; height: 100%; }
.wheel-picker-option { display: flex; align-items: center; justify-content: center; width: 100%; height: 76rpx; color: #000000; font-size: 32rpx; font-weight: 400; line-height: 52rpx; text-align: center; }
.wheel-picker-option--selected { font-size: 34rpx; font-weight: 500; }
.wheel-picker-option--empty { color: transparent; opacity: 0; }
.wheel-picker-fade { position: absolute; z-index: 2; right: 0; left: 0; height: 152rpx; pointer-events: none; }
.wheel-picker-fade--top { top: 0; background: linear-gradient(to bottom, rgba(255, 255, 255, .88), rgba(255, 255, 255, .36)); }
.wheel-picker-fade--bottom { bottom: 0; background: linear-gradient(to top, rgba(255, 255, 255, .88), rgba(255, 255, 255, .36)); }
