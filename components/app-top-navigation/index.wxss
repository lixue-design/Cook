:host { display: block; }
button { margin: 0; padding: 0; border: 0; background: transparent; font-family: "PingFang SC"; }
button::after { border: 0; }
.app-top-navigation { position: absolute; z-index: 1; top: 0; right: 0; left: 0; background: #fff; }
.app-top-navigation-title { position: absolute; left: 32rpx; display: flex; align-items: center; height: 24px; color: #191919; font-size: 40rpx; font-weight: 500; line-height: 24px; letter-spacing: -1.2rpx; }
.app-top-navigation-title--interactive { min-width: 128rpx; }
.app-top-navigation-indicator { display: flex; align-items: center; justify-content: center; width: 40rpx; height: 40rpx; margin-left: 8rpx; border-radius: 50%; background: #f5f6f7; }
.app-top-navigation-indicator-icon { width: 24rpx; height: 24rpx; transition: transform .18s ease; }
.app-top-navigation-indicator-icon--rotated { transform: rotate(180deg); }
.app-top-navigation-actions { position: absolute; display: flex; align-items: center; gap: 24rpx; height: 24px; }
.app-top-navigation-action { display: flex; align-items: center; justify-content: center; width: 24px; height: 24px; }
.app-top-navigation-action image { display: block; width: 24px; height: 24px; }
