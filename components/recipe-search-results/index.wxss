:host { display: block; width: 100%; }
.search-results { width: 100%; color: #000; background: #fff; font-family: "PingFang SC"; }
.search-result-item { position: relative; display: flex; align-items: flex-start; width: 100%; height: 160rpx; box-sizing: border-box; }
.search-result-item::after { position: absolute; right: 0; bottom: 16rpx; left: 128rpx; height: var(--size-auxiliary-line,.5px); background: var(--color-auxiliary-line,#ebedf2); content: ''; }
.search-result-cover { position: relative; width: 128rpx; height: 128rpx; flex: 0 0 128rpx; overflow: hidden; border-radius: 24rpx; background: #f2f3f9; }
.search-result-image { position: absolute; top: 0; left: 0; display: block; width: 100%; height: 100%; }
.search-result-copy { display: flex; min-width: 0; flex-direction: column; gap: 4rpx; margin-left: 24rpx; }
.search-result-title { max-width: 272rpx; overflow: hidden; color: #000; font-size: 28rpx; font-weight: 500; line-height: 48rpx; white-space: nowrap; text-overflow: ellipsis; }
.search-result-action { position: absolute; top: 84rpx; right: 32rpx; display: flex; align-items: center; justify-content: center; width: 92rpx; height: 44rpx; margin: 0; padding: 0; overflow: visible; border-radius: 4rpx; color: #000; background: #f5f6f7; font-size: 22rpx; line-height: 40rpx; }
.search-result-action::before { position: absolute; top: -22rpx; right: -20rpx; bottom: -22rpx; left: -20rpx; background: transparent; content: ''; }
.search-result-action::after { border: 0; }
.search-result-action--selected { color: #fff; background: var(--color-brand-primary, #0A74FF); }
.search-result-empty { padding-top: 120rpx; color: #b0b6c3; font-size: 28rpx; text-align: center; }
