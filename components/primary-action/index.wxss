:host { display: block; width: 100%; height: 88rpx; }
.primary-action { display: flex; align-items: center; justify-content: center; width: 100%; height: 88rpx; margin: 0; padding: 0; border-radius: 12rpx; color: #ffffff; background: var(--color-brand-primary, #0A74FF); font-family: "PingFang SC"; font-size: 32rpx; font-weight: 400; line-height: 52rpx; }
.primary-action::after { border: 0; }
.primary-action--disabled { color: #ffffff; background: #b0b6c3; }
