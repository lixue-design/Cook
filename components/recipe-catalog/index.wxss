:host { display: block; width: 100%; height: 100%; }
.catalog-shell { position: relative; display: flex; width: 100%; height: 100%; overflow: hidden; color: #000; background: #fff; font-family: "PingFang SC"; }
.catalog-sidebar { position: absolute; top: 0; bottom: 0; left: 0; width: 160rpx; box-sizing: border-box; background: #fff; }
.catalog-rail { position: absolute; z-index: 3; top: 0; bottom: 0; left: 0; width: 160rpx; pointer-events: none; }
.catalog-rail-base,.catalog-rail-active { position: absolute; right: 0; }
.catalog-rail-base { top: 0; bottom: 0; width: var(--size-auxiliary-line,.5px); background: var(--color-auxiliary-line,#ebedf2); }
.catalog-rail-active { width: 2rpx; height: 112rpx; background: #000; }
.catalog-tab { position: relative; z-index: 2; display: flex; align-items: center; width: 128rpx; height: 112rpx; margin: 0 0 0 32rpx; padding: 0; color: #7b818f; background: transparent; border-radius: 0; font-size: 24rpx; font-weight: 400; line-height: 40rpx; text-align: left; }
.catalog-tab::after { border: 0; }
.catalog-tab-label { width: 96rpx; max-height: 80rpx; overflow: hidden; }
.catalog-tab-line { display: block; width: 96rpx; height: 40rpx; overflow: hidden; white-space: nowrap; }
.catalog-tab--active { color: #000; font-weight: 500; }
.catalog-recipes { position: absolute; top: 0; right: 0; bottom: 0; left: 160rpx; padding: 0 0 0 32rpx; box-sizing: border-box; background: #fff; }
.catalog-section { width: 558rpx; margin-bottom: 48rpx; }
.catalog-section-title { display: block; width: 100%; height: 52rpx; margin-bottom: 32rpx; color: #000; font-size: 32rpx; font-weight: 500; line-height: 52rpx; }
.catalog-list { display: flex; flex-direction: column; width: 558rpx; gap: 32rpx; }
.catalog-item { position: relative; display: flex; flex: none; align-items: flex-start; width: 558rpx; height: 144rpx; background: #fff; }
.catalog-item::after { position: absolute; right: 0; bottom: 0; left: 128rpx; height: var(--size-auxiliary-line,.5px); background: var(--color-auxiliary-line,#ebedf2); content: ''; }
.catalog-cover-frame { position: relative; width: 128rpx; height: 128rpx; flex: 0 0 128rpx; overflow: hidden; border-radius: 24rpx; background: #f2f3f9; }
.catalog-cover { position: absolute; top: 0; left: 0; display: block; width: 100%; height: 100%; }
.catalog-copy { min-width: 0; margin-left: 24rpx; }
.catalog-title { display: block; max-width: 272rpx; overflow: hidden; color: #000; font-size: 28rpx; font-weight: 500; line-height: 48rpx; white-space: nowrap; text-overflow: ellipsis; }
.catalog-action { position: absolute; z-index: 1; right: 32rpx; bottom: 16rpx; display: flex; align-items: center; justify-content: center; width: 92rpx; height: 44rpx; margin: 0; padding: 0; overflow: visible; border-radius: 4rpx; color: #000; background: #f5f6f7; font-size: 22rpx; line-height: 40rpx; }
.catalog-action::before { position: absolute; top: -22rpx; right: -20rpx; bottom: -22rpx; left: -20rpx; background: transparent; content: ''; }
.catalog-action::after { border: 0; }
.catalog-action--selected { color: #fff; background: var(--color-brand-primary, #0A74FF); }
.catalog-tail { height: 128rpx; }
