page { height: 100%; overflow: hidden; background: #ffffff; font-family: "PingFang SC"; }
button, input { margin: 0; padding: 0; border: 0; background: transparent; font-family: "PingFang SC"; letter-spacing: 0; }
button::after { border: 0; }
.search-page { position: relative; width: 100%; height: 100vh; overflow: hidden; color: #000000; background: #ffffff; }
.search-navigation { position: absolute; z-index: 4; top: 0; right: 0; left: 0; background: #ffffff; }
.status-space { width: 100%; }
.navigation-row { position: relative; width: 100%; height: 44px; }
.back-button { position: absolute; top: 10px; left: 16px; width: 24px; height: 24px; }
.back-button view { position: absolute; top: 5.5px; left: 1px; width: 9px; height: 9px; box-sizing: border-box; border-left: 1.5px solid #4e5461; border-bottom: 1.5px solid #4e5461; transform: rotate(45deg); }
.search-box { position: absolute; z-index: 3; right: 32rpx; left: 32rpx; width: 686rpx; height: 72rpx; }
.result-scroll { position: absolute; right: 0; bottom: 0; left: 0; background: #ffffff; }
.result-list { display: block; width: 718rpx; margin-left: 32rpx; }
