page { height: 100%; overflow: hidden; background: #ffffff; font-family: "PingFang SC"; }
button,input { margin: 0; padding: 0; border: 0; background: transparent; font-family: "PingFang SC"; }
button::after { border: 0; }
.plan-create-page { position: relative; width: 100%; height: 100vh; overflow: hidden; color: #000; background: #fff; }
.plan-create-sheet { position: relative; width: 100%; height: 100%; overflow: hidden; background: #fff; }
.plan-create-header { position: absolute; top: 0; right: 0; left: 0; height: 140rpx; }
.plan-create-title { position: absolute; top: 48rpx; right: 0; left: 0; height: 52rpx; font-size: 32rpx; font-weight: 500; line-height: 52rpx; text-align: center; }
.plan-create-tabs { position: absolute; z-index: 3; top: 140rpx; right: 0; left: 0; display: flex; height: 68rpx; border-bottom: var(--size-auxiliary-line,.5px) solid var(--color-auxiliary-line,#ebedf2); background: #fff; }
.plan-create-tab { position: relative; display: flex; align-items: flex-start; justify-content: center; width: 50%; height: 68rpx; padding-top: 0; color: #999; font-size: 28rpx; font-weight: 400; line-height: 48rpx; }
.plan-create-tab--active { color: #000; font-weight: 500; }
.plan-create-tab--active::before { position: absolute; bottom: -1rpx; left: 50%; width: 124rpx; height: 4rpx; background: #000; transform: translateX(-50%); content: ''; }
.plan-create-tab:nth-child(2).plan-create-tab--active::before { width: 100rpx; }
.plan-create-search { position: absolute; z-index: 2; top: 240rpx; right: 32rpx; left: 32rpx; height: 72rpx; }
.plan-create-catalog { position: absolute; top: 344rpx; right: 0; left: 0; overflow: hidden; }
.plan-create-results { position: absolute; top: 344rpx; right: 0; left: 32rpx; width: 718rpx; background: #fff; }
.plan-create-note { position: absolute; top: 208rpx; right: 0; bottom: 0; left: 0; background: #fff; }
.plan-create-note-input { position: absolute; top: 42rpx; right: 32rpx; left: 32rpx; width: 686rpx; height: 80rpx; padding: 16rpx 24rpx; box-sizing: border-box; border-radius: 8rpx; color: #000; background: #f5f6f7; font-size: 28rpx; font-weight: 400; line-height: 48rpx; }
.plan-create-note-placeholder { color: #b0b6c3; }
.plan-create-footer { position: fixed; z-index: 8; right: 0; left: 0; padding: 24rpx 32rpx 0; box-sizing: border-box; background: #fff; box-shadow: 0 -1rpx 4rpx rgba(0,0,0,.04); }
