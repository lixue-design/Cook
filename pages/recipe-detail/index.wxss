page {
  height: 100%;
  overflow: hidden;
  background: #ffffff;
}

.detail-page {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  color: #000000;
  background: #ffffff;
}

.top-navigation {
  position: fixed;
  z-index: 100;
  top: 0;
  right: 0;
  left: 0;
  box-sizing: border-box;
  background: #ffffff;
  border-bottom: var(--size-auxiliary-line, 0.5px) solid var(--color-auxiliary-line, #EBEDF2);
}

.back-button {
  position: absolute;
  left: 32rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  width: 64rpx;
  margin: 0;
  padding: 0;
  background: transparent;
}

.back-icon {
  width: 16.2rpx;
  height: 29.2rpx;
}

.detail-scroll {
  position: absolute;
  right: 0;
  left: 0;
  width: 100%;
  box-sizing: border-box;
  background: #ffffff;
}

.hero-media,
.hero-image {
  display: block;
  width: 100%;
  height: 400rpx;
}

.step-image {
  background: #ebedf2;
}

.hero-copy {
  padding: 0 32rpx;
  box-sizing: border-box;
}

.hero-title {
  display: block;
  margin-top: 48rpx;
  color: #000000;
  font-size: 44rpx;
  font-weight: 500;
  line-height: 62rpx;
}

.tag-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 40rpx;
  margin-top: 16rpx;
}

.info-tag {
  display: flex;
  align-items: center;
  height: 40rpx;
  padding: 0 8rpx;
  color: #7B818F;
  border: 1rpx solid #7B818F;
  border-radius: 0;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 40rpx;
  box-sizing: border-box;
}

.content-divider {
  height: var(--size-auxiliary-line, 0.5px);
  margin: 32rpx 0 0 32rpx;
  background: var(--color-auxiliary-line, #EBEDF2);
}

.detail-content {
  padding: 0 32rpx;
  box-sizing: border-box;
}

.ingredient-section {
  margin-top: 48rpx;
}

.section-heading {
  display: block;
  color: #000000;
  font-size: 36rpx;
  font-weight: 500;
  line-height: 56rpx;
}

.ingredient-preparation {
  display: block;
  margin-top: 32rpx;
  color: #000000;
  font-size: 32rpx;
  font-weight: 400;
  line-height: 52rpx;
}

.steps-section {
  margin-top: 60rpx;
}

.steps-section--first { margin-top: 48rpx; }

.steps-list {
  margin-top: 32rpx;
}

.step-card {
  display: flex;
  align-items: flex-start;
}

.step-card + .step-card {
  margin-top: 24rpx;
}

.step-number {
  width: 32rpx;
  flex: none;
  color: #000000;
  font-size: 32rpx;
  font-weight: 400;
  line-height: 52rpx;
  text-align: right;
}

.step-body {
  min-width: 0;
  flex: 1;
  margin-left: 16rpx;
}

.step-text {
  display: block;
  color: #000000;
  font-size: 32rpx;
  font-weight: 400;
  line-height: 52rpx;
  letter-spacing: 0;
  text-align: justify;
}

.step-image {
  display: block;
  width: 400rpx;
  height: 256rpx;
  margin-top: 24rpx;
  margin-left: -4rpx;
  border-radius: 4rpx;
}

.scroll-bottom-spacer {
  height: 52rpx;
}

.detail-state {
  position: absolute;
  right: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  color: #7b818f;
  background: #ffffff;
  font-size: 28rpx;
}

.detail-retry {
  height: 64rpx;
  margin-top: 24rpx;
  padding: 0 28rpx;
  border-radius: 12rpx;
  color: #ffffff;
  background: var(--color-brand-primary, #0A74FF);
  font-size: 24rpx;
  line-height: 64rpx;
}

.spinner {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid #ebedf2;
  border-top-color: #4e5461;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.bottom-action-bar {
  position: fixed;
  z-index: 100;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  background: #ffffff;
  box-shadow: 0 -8rpx 16rpx rgba(60, 95, 155, 0.04);
}

.action-row {
  position: absolute;
  top: 16rpx;
  left: 50%;
  display: flex;
  align-items: flex-start;
  width: 600rpx;
  height: 96rpx;
  gap: 136rpx;
  transform: translateX(-50%);
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 0 0 48rpx;
  width: 48rpx;
  height: 96rpx;
  overflow: visible;
  margin: 0;
  padding: 6rpx 0 0;
  color: #000000;
  background: transparent;
  font-size: 20rpx;
  font-weight: 400;
  line-height: 28rpx;
  box-sizing: border-box;
}

.basket-week-picker {
  display: block;
  width: 48rpx;
  height: 96rpx;
  flex: 0 0 48rpx;
}

.action-item::after { border: 0; }

.action-icon {
  display: block;
  width: 48rpx;
  height: 48rpx;
}

.action-item text {
  display: block;
  min-width: 84rpx;
  height: 28rpx;
  margin-top: 8rpx;
  line-height: 28rpx;
  text-align: center;
  white-space: nowrap;
}
