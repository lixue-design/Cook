page { height: 100%; overflow: hidden; background: #ffffff; }

.recipe-editor { position: relative; width: 100%; height: 100vh; overflow: hidden; color: #191919; background: #ffffff; font-family: "PingFang SC", -apple-system, BlinkMacSystemFont, sans-serif; }
.text-generation-page { position: relative; width: 100%; height: 100vh; overflow: hidden; color: #191919; background: #ffffff; font-family: "PingFang SC", -apple-system, BlinkMacSystemFont, sans-serif; }
.editor-navigation { position: fixed; z-index: 20; top: 0; right: 0; left: 0; box-sizing: border-box; border-bottom: 1rpx solid #EBEDF2; background: #ffffff; }
.editor-back { position: absolute; left: 32rpx; display: flex; align-items: center; justify-content: flex-start; width: 48rpx; margin: 0; padding: 0; background: transparent; }
.editor-back image { display: block; width: 13rpx; height: 29rpx; }
.editor-scroll { position: absolute; right: 0; left: 0; box-sizing: border-box; background: #ffffff; }

.editor-top-form, .editor-section { width: 718rpx; margin-left: 32rpx; box-sizing: border-box; }
.editor-top-form { display: flex; flex-direction: column; gap: 26rpx; padding-top: 27rpx; margin-bottom: 27rpx; }
.recipe-name-field { position: relative; width: 718rpx; height: 52rpx; }
.recipe-name-input { position: absolute; inset: 0; width: 718rpx; height: 52rpx; padding: 0; color: #191919; font-family: "PingFang SC"; font-size: 32rpx; font-weight: 400; line-height: 52rpx; letter-spacing: -0.96rpx; }
.recipe-name-placeholder { color: #b0b6c3; font-weight: 400; }
.editor-placeholder, .native-placeholder { color: #b0b6c3; }
.editor-line { width: 100%; height: 0; flex: none; box-sizing: border-box; border-top: 1rpx solid #EBEDF2; }
.editor-row { display: flex; align-items: center; justify-content: space-between; width: 686rpx; height: 96rpx; margin: 0; padding: 0; border: 0; background: transparent; text-align: left; }
.editor-row-leading { display: flex; align-items: center; gap: 48rpx; }
.editor-row-label { flex: none; color: #4e5461; font-size: 28rpx; font-weight: 400; line-height: 48rpx; letter-spacing: -0.84rpx; }
.image-picker, .step-image-picker { display: flex; align-items: center; justify-content: center; width: 96rpx; height: 96rpx; overflow: hidden; padding: 0; border: 0; border-radius: 4rpx; background: #f5f6f7; }
.image-picker--filled, .step-image-picker--filled { background: #ebedf2; }
.camera-icon { display: block; width: 48rpx; height: 48rpx; }
.selected-image { display: block; width: 100%; height: 100%; }
.editor-chevron { display: block; width: 16rpx; height: 28rpx; }
.category-picker-shell { display: block; width: 686rpx; height: 48rpx; }
.category-picker { height: 48rpx; }
.category-value { width: 518rpx; overflow: hidden; color: #000000; font-family: "PingFang SC"; font-size: 28rpx; font-weight: 400; line-height: 48rpx; letter-spacing: -0.84rpx; white-space: nowrap; text-overflow: ellipsis; }
.category-value.editor-placeholder { color: #b0b6c3; }

.editor-section-gap { width: 100%; height: 16rpx; background: #f2f3f9; }
.editor-section { display: flex; flex-direction: column; gap: 24rpx; padding-top: 24rpx; padding-bottom: 24rpx; }
.editor-section-title { color: #191919; font-size: 32rpx; font-weight: 500; line-height: 52rpx; letter-spacing: -0.96rpx; }
.ingredient-section { padding-bottom: 24rpx; }
.ingredient-input-wrap { position: relative; width: 686rpx; min-height: 96rpx; }
.ingredient-input { display: block; width: 686rpx; min-height: 96rpx; box-sizing: border-box; padding: 0; color: #191919; font-family: "PingFang SC"; font-size: 28rpx; font-weight: 400; line-height: 48rpx; letter-spacing: -0.84rpx; }
.ingredient-placeholder { color: #b0b6c3; font-family: "PingFang SC"; font-size: 28rpx; font-weight: 400; line-height: 48rpx; letter-spacing: -0.84rpx; }
.steps-section { gap: 26rpx; padding-top: 28rpx; }
.step-editor { display: flex; flex-direction: column; gap: 26rpx; width: 100%; }
.step-swipe { width: 750rpx; margin-right: -32rpx; overflow: hidden; }
.step-swipe-track { display: flex; width: 902rpx; transition: transform 180ms ease; transform: translateX(0); }
.step-swipe-track--open { transform: translateX(-184rpx); }
.step-input-row { display: flex; flex: 0 0 750rpx; align-items: flex-start; width: 750rpx; min-height: 96rpx; }
.step-image-picker { flex: none; }
.step-input { width: 566rpx; min-height: 96rpx; margin-left: 24rpx; padding: 0; color: #191919; font-family: inherit; font-size: 28rpx; font-weight: 400; line-height: 48rpx; letter-spacing: -0.84rpx; }
.step-delete-action { flex: 0 0 152rpx; align-self: stretch; min-height: 96rpx; margin: 0; padding: 0; border-radius: 0; color: #ffffff; background: #ff4b36; font-size: 28rpx; font-weight: 500; line-height: 96rpx; }
.add-step { display: flex; align-items: center; width: 686rpx; height: 48rpx; margin: 0; padding: 0; border: 0; color: #b0b6c3; background: transparent; text-align: left; }
.add-step image { width: 32rpx; height: 32rpx; margin-right: 16rpx; }
.add-step text { color: #b0b6c3; font-size: 28rpx; font-weight: 400; line-height: 48rpx; letter-spacing: -0.84rpx; }
.editor-bottom-filler { height: 534rpx; background: #f2f3f9; }

.editor-footer { position: fixed; z-index: 25; right: 0; bottom: 0; left: 0; box-sizing: border-box; padding: 24rpx 32rpx 0; border-top: 1rpx solid #EBEDF2; background: #ffffff; }
.submit-button { display: flex; align-items: center; justify-content: center; width: 686rpx; height: 88rpx; margin: 0; padding: 0; border-radius: 12rpx; color: #ffffff; background: #0a74ff; font-family: inherit; font-size: 32rpx; font-weight: 500; line-height: 52rpx; }
.submit-button[disabled] { background: #b0b6c3; }

.text-generation-input { position: absolute; right: 0; left: 0; box-sizing: border-box; width: 100%; padding: 24rpx 32rpx; color: #191919; background: #ffffff; font-family: "PingFang SC", -apple-system, BlinkMacSystemFont, sans-serif; font-size: 28rpx; font-weight: 400; line-height: 48rpx; letter-spacing: -0.84rpx; resize: none; }
.text-generation-placeholder { color: #b0b6c3; font-family: "PingFang SC", -apple-system, BlinkMacSystemFont, sans-serif; font-size: 28rpx; font-weight: 400; line-height: 48rpx; letter-spacing: -0.84rpx; }
.text-generation-footer { position: fixed; z-index: 25; right: 0; bottom: 0; left: 0; box-sizing: border-box; padding: 24rpx 32rpx 0; border-top: 1rpx solid #EBEDF2; background: #ffffff; box-shadow: 0 0 4rpx rgba(0, 0, 0, 0.1); }
.text-generation-confirm { display: flex; align-items: center; justify-content: center; width: 686rpx; height: 88rpx; margin: 0; padding: 0; border-radius: 12rpx; color: #ffffff; background: #0a74ff; font-family: "PingFang SC", -apple-system, BlinkMacSystemFont, sans-serif; font-size: 32rpx; font-weight: 400; line-height: 52rpx; }
.text-generation-confirm[disabled] { background: #b0b6c3; }
