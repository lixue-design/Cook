<view class="about-page">
  <view class="about-navigation" style="height: {{navigationBottom}}px;">
    <view class="status-space" style="height: {{statusBarHeight}}px;"></view>
    <view class="about-navigation-row">
      <button class="about-back" hover-class="none" aria-label="返回" bindtap="goBack"><image src="/assets/about/back.svg" mode="aspectFit" /></button>
      <text class="about-navigation-title">关于我们</text>
    </view>
    <view class="about-navigation-line"></view>
  </view>

  <view class="about-content">
    <view class="about-menu {{loggedIn ? '' : 'about-menu--guest'}}">
      <button class="about-menu-row" hover-class="none" data-type="terms" bindtap="openAgreement">
        <text>用户协议</text>
        <image src="/assets/profile/menu-arrow.svg" mode="aspectFit" />
      </button>
      <view class="about-menu-divider"></view>
      <button class="about-menu-row" hover-class="none" data-type="privacy" bindtap="openAgreement">
        <text>隐私协议</text>
        <image src="/assets/profile/menu-arrow.svg" mode="aspectFit" />
      </button>
      <block wx:if="{{loggedIn}}">
        <view class="about-menu-divider"></view>
        <button class="about-menu-row" hover-class="none" bindtap="openCancelAccount">
          <text>账号注销</text>
          <image src="/assets/profile/menu-arrow.svg" mode="aspectFit" />
        </button>
      </block>
    </view>

    <button wx:if="{{loggedIn}}" class="about-logout" hover-class="none" loading="{{loggingOut}}" disabled="{{loggingOut}}" bindtap="onLogout">退出登录</button>
  </view>
</view>
