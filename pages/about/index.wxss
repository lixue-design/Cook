page {
  min-height: 100%;
  background: #f2f3f9;
  font-family: "PingFang SC", -apple-system, BlinkMacSystemFont, sans-serif;
}

button { margin: 0; padding: 0; border: 0; font-family: inherit; }
button::after { border: 0; }

.about-page { min-height: 100vh; color: #000; background: #f2f3f9; }

.about-navigation {
  position: relative;
  box-sizing: border-box;
  background: #fff;
}

.status-space { width: 100%; }
.about-navigation-row { position: relative; width: 100%; height: 44px; }

.about-back {
  position: absolute;
  top: 10px;
  left: 16px;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  width: 24px;
  height: 24px;
  background: transparent;
}

.about-back image { width: 17rpx; height: 30rpx; }

.about-navigation-title {
  position: absolute;
  top: 11px;
  right: 0;
  left: 0;
  color: #000;
  font-size: 32rpx;
  font-weight: 400;
  line-height: 44rpx;
  text-align: center;
}

.about-navigation-line {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 1rpx;
  background: #ebedf2;
}

.about-content { padding-top: 32rpx; }

.about-menu {
  width: 686rpx;
  height: 318rpx;
  margin: 0 32rpx;
  padding: 28rpx 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-sizing: border-box;
  overflow: hidden;
  border-radius: 12rpx;
  background: #fff;
}

.about-menu--guest {
  height: 208rpx;
}

.about-menu-row {
  width: 100%;
  height: 48rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  color: #000;
  background: #fff;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 48rpx;
  text-align: left;
}

.about-menu-row image { width: 16rpx; height: 32rpx; }
.about-menu-divider { width: 100%; height: 1rpx; background: #ececec; }

.about-logout {
  width: 686rpx;
  height: 90rpx;
  margin: 64rpx 32rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  color: #000;
  background: #fff;
  font-size: 32rpx;
  font-weight: 400;
  line-height: 52rpx;
}

.about-logout[disabled] { opacity: .65; }
