page {
  height: 100%;
  overflow: hidden;
  background: #f2f3f9;
  font-family: "PingFang SC", -apple-system, BlinkMacSystemFont, sans-serif;
}

button, input { margin: 0; padding: 0; border: 0; font-family: inherit; }
button::after { border: 0; }

.profile-edit-page { position: relative; width: 100%; height: 100vh; overflow: hidden; color: #000; background: #f2f3f9; }

.profile-edit-navigation {
  position: absolute;
  z-index: 2;
  top: 0;
  right: 0;
  left: 0;
  box-sizing: border-box;
  background: #fff;
}

.status-space { width: 100%; }
.profile-edit-navigation-row { position: relative; width: 100%; height: 44px; }

.profile-edit-back {
  position: absolute;
  top: 10px;
  left: 16px;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  width: 24px;
  height: 24px;
  background: transparent;
}

.profile-edit-back image { width: 17rpx; height: 30rpx; }

.profile-edit-navigation-title {
  position: absolute;
  top: 11px;
  right: 0;
  left: 0;
  color: #000;
  font-size: 32rpx;
  font-weight: 400;
  line-height: 44rpx;
  text-align: center;
}

.profile-edit-navigation-line { position: absolute; right: 0; bottom: 0; left: 0; height: 1rpx; background: #ebedf2; }

.profile-edit-content { box-sizing: border-box; }

.profile-edit-card {
  width: 686rpx;
  margin: 0 32rpx;
  overflow: hidden;
  border-radius: 12rpx;
  background: #fff;
}

.profile-edit-row {
  width: 100%;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  color: #000;
  background: #fff;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 48rpx;
  text-align: left;
}

.profile-edit-avatar-row { height: 144rpx; }
.profile-edit-name-row { height: 104rpx; }
.profile-edit-divider { width: 100%; height: 1rpx; background: #ececec; }

.profile-edit-avatar-value { display: flex; align-items: center; }

.profile-edit-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #191919;
}

.profile-edit-arrow { width: 16rpx; height: 32rpx; margin-left: 24rpx; }

.profile-edit-name-input {
  width: 460rpx;
  color: #191919;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 48rpx;
  text-align: right;
}

.profile-edit-placeholder { color: #b0b6c3; }

.profile-edit-bottom-action {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 160rpx;
  padding-top: 24rpx;
  box-sizing: border-box;
  background: #fff;
  box-shadow: 0 -1rpx 4rpx rgba(0, 0, 0, .08);
}

.profile-edit-save {
  width: 686rpx;
  height: 88rpx;
  margin: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  color: #fff;
  background: #0a74ff;
  font-size: 32rpx;
  font-weight: 400;
  line-height: 52rpx;
}

.profile-edit-save[disabled] { opacity: .65; }
