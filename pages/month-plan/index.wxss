page {
  height: 100%;
  overflow: hidden;
  background: #f2f3f9;
  font-family: "PingFang SC";
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  font-family: "PingFang SC";
  letter-spacing: 0;
}

button::after { border: 0; }

.month-page {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  color: #191919;
  background: #f2f3f9;
}

.month-navigation {
  position: absolute;
  z-index: 10;
  top: 0;
  right: 0;
  left: 0;
  background: #ffffff;
}

.status-space { width: 100%; }
.navigation-row { position: relative; width: 100%; height: 44px; }

.back-button {
  position: absolute;
  top: 10px;
  left: 16px;
  width: 24px;
  height: 24px;
}

.back-button view {
  position: absolute;
  top: 5.5px;
  left: 1px;
  width: 9px;
  height: 9px;
  box-sizing: border-box;
  border-left: 1.5px solid #4e5461;
  border-bottom: 1.5px solid #4e5461;
  transform: rotate(45deg);
}

.navigation-title {
  position: absolute;
  right: 96rpx;
  left: 96rpx;
  height: 44px;
  color: #191919;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 44px;
  text-align: center;
}

.navigation-line {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: var(--size-auxiliary-line, .5px);
  background: var(--color-auxiliary-line, #EBEDF2);
}

.month-content {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  background: #f2f3f9;
}

.month-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 144rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
  background: #ffffff;
}

.month-step {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  color: #191919;
  font-size: 56rpx;
  font-weight: 300;
  line-height: 72rpx;
}

.month-heading {
  display: flex;
  align-items: center;
  flex-direction: column;
  min-width: 0;
}

.month-title {
  color: #191919;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 52rpx;
}

.month-subtitle {
  margin-top: 4rpx;
  color: #7a8190;
  font-size: 24rpx;
  line-height: 36rpx;
}

.weekday-row {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  height: 64rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
  background: #ffffff;
  border-top: var(--size-auxiliary-line, .5px) solid var(--color-auxiliary-line, #EBEDF2);
}

.weekday-row text {
  color: #7a8190;
  font-size: 24rpx;
  line-height: 64rpx;
  text-align: center;
}

.month-scroll {
  flex: 1;
  min-height: 0;
}

.month-state,
.month-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 320rpx;
  color: #7a8190;
  font-size: 28rpx;
  line-height: 44rpx;
}

.month-state--error {
  flex-direction: column;
  gap: 24rpx;
}

.month-state--error button {
  width: 192rpx;
  height: 64rpx;
  border-radius: 8rpx;
  color: #ffffff;
  background: var(--color-brand-primary, #0A74FF);
  font-size: 26rpx;
  line-height: 64rpx;
}

.month-empty {
  min-height: 96rpx;
  padding-top: 32rpx;
}

.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 2rpx;
  padding: 16rpx;
  box-sizing: border-box;
}

.calendar-cell {
  min-height: 176rpx;
  padding: 10rpx 8rpx;
  box-sizing: border-box;
  overflow: hidden;
  background: #ffffff;
}

.calendar-cell--placeholder {
  background: transparent;
}

.calendar-cell--filled {
  box-shadow: inset 0 0 0 2rpx #191919;
}

.cell-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 32rpx;
}

.cell-day {
  color: #191919;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 32rpx;
}

.cell-weekday {
  color: #b0b6c3;
  font-size: 18rpx;
  line-height: 28rpx;
}

.meal-lines {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-top: 10rpx;
}

.meal-line {
  display: flex;
  align-items: center;
  min-width: 0;
  height: 30rpx;
  color: #b0b6c3;
  font-size: 18rpx;
  line-height: 30rpx;
}

.meal-line--filled { color: #191919; }

.meal-label {
  width: 24rpx;
  flex: none;
  font-weight: 500;
}

.meal-text {
  min-width: 0;
  overflow: hidden;
  flex: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}
