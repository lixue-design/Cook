page {
  height: 100%;
  overflow: hidden;
  background: #f2f3f9;
  font-family: "PingFang SC", -apple-system, BlinkMacSystemFont, sans-serif;
}

button, textarea { margin: 0; padding: 0; border: 0; font-family: inherit; }
button::after { border: 0; }

.feedback-page { position: relative; width: 100%; height: 100vh; overflow: hidden; color: #000; background: #f2f3f9; }

.feedback-navigation {
  position: absolute;
  z-index: 2;
  top: 0;
  right: 0;
  left: 0;
  box-sizing: border-box;
  background: #fff;
}

.status-space { width: 100%; }
.feedback-navigation-row { position: relative; width: 100%; height: 44px; }

.feedback-back {
  position: absolute;
  top: 10px;
  left: 16px;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  width: 24px;
  height: 24px;
  background: transparent;
}

.feedback-back image { width: 17rpx; height: 30rpx; }

.feedback-navigation-title {
  position: absolute;
  top: 11px;
  right: 0;
  left: 0;
  color: #000;
  font-size: 32rpx;
  font-weight: 400;
  line-height: 44rpx;
  text-align: center;
}

.feedback-navigation-line { position: absolute; right: 0; bottom: 0; left: 0; height: 1rpx; background: #ebedf2; }

.feedback-scroll { position: absolute; right: 0; left: 0; box-sizing: border-box; }

.feedback-card {
  width: 686rpx;
  margin: 32rpx 32rpx 0;
  padding: 28rpx 32rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  background: #fff;
}

.feedback-label { color: #000; font-size: 28rpx; font-weight: 400; line-height: 48rpx; }

.feedback-textarea {
  width: 100%;
  min-height: 240rpx;
  margin-top: 16rpx;
  box-sizing: border-box;
  color: #191919;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 48rpx;
}

.feedback-placeholder { color: #b0b6c3; }
.feedback-counter { display: block; margin-top: 8rpx; color: #a3a6ae; font-size: 24rpx; line-height: 40rpx; text-align: right; }

.feedback-card--images { padding-bottom: 32rpx; }
.feedback-image-heading { display: flex; align-items: center; justify-content: space-between; }
.feedback-optional { color: #7b818f; font-size: 24rpx; line-height: 40rpx; }

.feedback-image-grid { margin-top: 24rpx; display: flex; flex-wrap: wrap; gap: 16rpx; }

.feedback-image-item,
.feedback-image-add {
  position: relative;
  width: 192rpx;
  height: 192rpx;
  overflow: hidden;
  border-radius: 12rpx;
}

.feedback-image-item image { width: 100%; height: 100%; display: block; }

.feedback-image-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #fff;
  background: rgba(0, 0, 0, .56);
  font-size: 28rpx;
  line-height: 36rpx;
}

.feedback-image-add {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  box-sizing: border-box;
  border: 1rpx dashed #c1c8c4;
  color: #7b818f;
  background: #f6f8fb;
  font-size: 24rpx;
  line-height: 40rpx;
}

.feedback-image-add-icon { font-size: 44rpx; font-weight: 300; line-height: 52rpx; }

.feedback-bottom-action {
  position: absolute;
  z-index: 2;
  right: 0;
  bottom: 0;
  left: 0;
  height: 160rpx;
  padding-top: 24rpx;
  box-sizing: border-box;
  background: #fff;
  box-shadow: 0 -1rpx 4rpx rgba(0, 0, 0, .08);
}

.feedback-submit {
  width: 686rpx;
  height: 88rpx;
  margin: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  color: #fff;
  background: #0a74ff;
  font-size: 32rpx;
  font-weight: 400;
  line-height: 52rpx;
}

.feedback-submit[disabled] { opacity: .65; }
