page { background: #f2f3f9; }

.profile-page {
  min-height: 100vh;
  padding-right: 32rpx;
  padding-left: 32rpx;
  box-sizing: border-box;
  overflow: hidden;
  color: #191919;
  background: #f2f3f9;
  font-family: "PingFang SC", -apple-system, BlinkMacSystemFont, sans-serif;
}

.profile-loading {
  width: 40rpx;
  height: 40rpx;
  margin: 28rpx auto 0;
  border: 3rpx solid #e2ebea;
  border-top-color: #0a74ff;
  border-radius: 50%;
  animation: profile-spin 800ms linear infinite;
}

@keyframes profile-spin { to { transform: rotate(360deg); } }

.account-entry {
  width: 100%;
  margin: 0;
  padding: 0;
  border-radius: 0;
  box-sizing: border-box;
  color: #191919;
  background: transparent;
  font-family: inherit;
  text-align: left;
}

.account-entry::after,
.profile-menu-row::after { border: 0; }

.account-entry--guest {
  height: 88rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-start;
}

.guest-title-row {
  height: 52rpx;
  display: flex;
  align-items: center;
}

.account-entry--user {
  height: 96rpx;
  display: flex;
  align-items: center;
}

.account-avatar {
  width: 96rpx;
  height: 96rpx;
  flex: 0 0 96rpx;
  border-radius: 50%;
  background: #191919;
}

.account-copy {
  min-width: 0;
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.account-more-arrow {
  width: 48rpx;
  height: 48rpx;
  margin-left: 16rpx;
  flex: 0 0 48rpx;
}

.account-title {
  max-width: 100%;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 52rpx;
}

.account-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.account-description {
  max-width: 100%;
  overflow: hidden;
  color: #7b818f;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 40rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.login-arrow {
  width: 48rpx;
  height: 48rpx;
  margin-left: 4rpx;
  flex: 0 0 48rpx;
}

.profile-menu {
  width: 100%;
  height: 208rpx;
  margin-top: 40rpx;
  overflow: hidden;
  border-radius: 12rpx;
  background: #fff;
}

.profile-menu--guest {
  margin-top: 48rpx;
}

.profile-menu-row {
  width: 100%;
  height: 105rpx;
  margin: 0;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  color: #191919;
  background: #fff;
  font-family: inherit;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 48rpx;
  text-align: left;
}

.profile-menu-row,
.profile-menu-row:last-child {
  height: calc((208rpx - 1rpx) / 2);
}

.profile-menu-divider {
  width: 100%;
  height: 1rpx;
  background: #e2ebea;
}

.menu-arrow {
  width: 16rpx;
  height: 32rpx;
  flex: 0 0 16rpx;
}

.login-sheet {
  position: relative;
  width: 100%;
  height: 100%;
  color: #000;
  background: #fff;
}

.login-sheet-brand {
  position: absolute;
  top: 130rpx;
  left: 32rpx;
  width: 144rpx;
  height: 144rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 40rpx;
  background: #fff;
}

.login-sheet-brand image {
  width: 98rpx;
  height: 98rpx;
  display: block;
}

.login-sheet-copy {
  position: absolute;
  top: 338rpx;
  left: 56rpx;
  width: 668rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  align-items: flex-start;
  color: #000;
  font-size: 40rpx;
  font-weight: 400;
  letter-spacing: 4rpx;
  line-height: 64rpx;
  white-space: nowrap;
}

.login-agreement {
  position: absolute;
  left: 32rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
}

.login-agreement-checkbox {
  position: relative;
  width: 32rpx;
  height: 32rpx;
  margin: 0;
  padding: 0;
  flex: 0 0 32rpx;
  box-sizing: border-box;
  border: 2rpx solid #828282;
  border-radius: 8rpx;
  background: #fff;
}

.login-agreement-checkbox::after { border: 0; }

.login-agreement-checkbox--checked {
  border-color: #0a74ff;
  background: #0a74ff;
}

.login-agreement-checkmark {
  position: absolute;
  top: 7rpx;
  left: 10rpx;
  width: 8rpx;
  height: 14rpx;
  box-sizing: border-box;
  border-right: 3rpx solid #fff;
  border-bottom: 3rpx solid #fff;
  transform: rotate(45deg);
}

.login-agreement-copy {
  margin-left: 24rpx;
  color: #7b818f;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 48rpx;
  white-space: nowrap;
}

.login-agreement-link { color: #0a74ff; }

.login-sheet-button {
  position: absolute;
  right: 32rpx;
  left: 32rpx;
  width: auto;
  height: 88rpx;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  color: #fff;
  background: #0a74ff;
  font-family: inherit;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 52rpx;
}

.login-sheet-button::after { border: 0; }
.login-sheet-button[disabled] { color: #fff; background: #0a74ff; opacity: .7; }
