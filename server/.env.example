# Local development only. Copy to server/.env and replace placeholders.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
POSTGRES_USER=dish_library
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=dish_library
POSTGRES_PORT=54329
DATABASE_URL=postgresql://dish_library:replace-with-local-password@127.0.0.1:54329/dish_library
# Bootstrap connects to an existing maintenance database and creates TARGET_DATABASE_NAME when missing.
ADMIN_DATABASE_URL=postgresql://postgres:replace-with-admin-password@127.0.0.1:54329/postgres
TARGET_DATABASE_NAME=cook
# Integration tests refuse DATABASE_URL and require a separately named test database.
TEST_DATABASE_URL=postgresql://dish_library:replace-with-local-password@127.0.0.1:54329/dish_library_test
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
IMAGE_STORAGE_ROOT=../storage/dish-images
# Optional Ark fallback. Generation stays disabled unless both values are configured.
ARK_API_KEY=
ARK_IMAGE_MODEL=doubao-seedream-4-0-250828
ARK_IMAGE_API_URL=https://ark.cn-beijing.volces.com/api/v3/images/generations
ARK_IMAGE_TIMEOUT_MS=180000
# Optional admin API token. Leave empty to keep /api/admin/* disabled.
ADMIN_API_TOKEN=
