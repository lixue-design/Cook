.text-entry-dialog-layer {
  position: fixed;
  z-index: 300;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.6);
  transition: bottom 180ms ease-out;
}

.text-entry-dialog {
  position: relative;
  width: 590rpx;
  height: 354rpx;
  overflow: hidden;
  border-radius: 12rpx;
  background: #ffffff;
}

.text-entry-dialog--message { height: 378rpx; }

.text-entry-dialog-title {
  position: absolute;
  top: 48rpx;
  right: 48rpx;
  left: 48rpx;
  height: 52rpx;
  color: #000000;
  font-size: 32rpx;
  font-weight: 400;
  line-height: 52rpx;
  text-align: center;
}

.text-entry-dialog-input {
  position: absolute;
  top: 132rpx;
  left: 48rpx;
  width: 494rpx;
  height: 72rpx;
  padding: 16rpx 24rpx;
  box-sizing: border-box;
  border-radius: 8rpx;
  color: #000000;
  background: #f5f6f7;
  font-family: "PingFang SC";
  font-size: 28rpx;
  font-weight: 400;
  line-height: 40rpx;
}

.text-entry-dialog-placeholder { color: #b0b6c3; }

.text-entry-dialog-message {
  position: absolute;
  top: 132rpx;
  left: 48rpx;
  width: 494rpx;
  height: 96rpx;
  color: #666666;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 48rpx;
}

.text-entry-dialog-actions {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  height: 102rpx;
  border-top: 2rpx solid #e2ebea;
}

.text-entry-dialog-actions button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 102rpx;
  margin: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  font-size: 32rpx;
  font-weight: 400;
  line-height: 52rpx;
}

.text-entry-dialog-cancel { color: #999999; }
.text-entry-dialog-confirm { color: #000000; border-left: 2rpx solid #e2ebea; }
